rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function active(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().disabled != true && profile().role in ['admin','user','intern'];}
  function admin(){return active() && profile().role == 'admin';}
  function staff(){return active() && profile().role in ['admin','user'];}
  match /users/{uid} {
   allow read: if admin() || (active() && request.auth.uid == uid);
   allow write: if admin();
  }
  match /preparations/{id} {
   allow read: if active();
   allow create, delete: if staff();
   allow update: if staff() || (active() && profile().role == 'intern' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','completedBy','completedByUid','completedAt','updatedAt']));
  }
  match /eventPreparations/{id} {
   allow read: if active();
   allow create, delete: if staff();
   allow update: if staff() || (active() && profile().role == 'intern' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','completedBy','updatedAt']));
  }
  match /{collection}/{id} {
   allow read: if active() && collection in ['shifts','events','eventEquipment','weeklyPlan','inventory','orders','staffMeals','apronHistory','menuRecipes','menuIdeas','teamProfiles'];
   allow write: if admin() && collection in ['shifts','events','eventEquipment','weeklyPlan','inventory','orders','staffMeals','apronHistory','menuRecipes','menuIdeas','teamProfiles'];
   allow create, update, delete: if staff() && collection in ['weeklyPlan','inventory','orders','staffMeals','apronHistory','menuRecipes','menuIdeas','teamProfiles','eventEquipment'];
  }
 }
}
